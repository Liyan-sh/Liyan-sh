import java.awt.*;
import java.util.List;
import javax.swing.*;
import javax.swing.table.DefaultTableModel;

public class AdminPanel extends JFrame {
    private JTable userTable;
    private JButton refreshBtn, logoutBtn, blockBtn, deleteBtn;

    private static final Color DARK_PINK = new Color(139, 0, 139);
    private static final Color FONT_WHITE = Color.WHITE;

    public AdminPanel() {
        setTitle("Admin Panel - User Information");
        setSize(800, 450);
        setLocationRelativeTo(null);
        setDefaultCloseOperation(EXIT_ON_CLOSE);
        setLayout(new BorderLayout());

        getContentPane().setBackground(DARK_PINK);

        String[] columnNames = {"NID", "Username", "DOB", "Address", "Sex", "Phone", "Balance", "Blocked"};
        DefaultTableModel model = new DefaultTableModel(columnNames, 0) {
            @Override
            public boolean isCellEditable(int row, int column) {
                return false; // Make table non-editable directly
            }
        };
        userTable = new JTable(model);
        userTable.setFillsViewportHeight(true);
        userTable.setBackground(DARK_PINK.darker());
        userTable.setForeground(FONT_WHITE);
        userTable.setFont(new Font("Segoe UI", Font.PLAIN, 14));
        userTable.getTableHeader().setBackground(DARK_PINK.darker());
        userTable.getTableHeader().setForeground(FONT_WHITE);
        JScrollPane scrollPane = new JScrollPane(userTable);
        add(scrollPane, BorderLayout.CENTER);

        JPanel buttonPanel = new JPanel(new FlowLayout(FlowLayout.RIGHT));
        buttonPanel.setBackground(DARK_PINK);

        refreshBtn = new JButton("Refresh");
        refreshBtn.setBackground(DARK_PINK.darker());
        refreshBtn.setForeground(FONT_WHITE);

        blockBtn = new JButton("Block/Unblock User");
        blockBtn.setBackground(DARK_PINK.darker());
        blockBtn.setForeground(FONT_WHITE);

        deleteBtn = new JButton("Delete User");
        deleteBtn.setBackground(DARK_PINK.darker());
        deleteBtn.setForeground(FONT_WHITE);

        logoutBtn = new JButton("Logout");
        logoutBtn.setBackground(DARK_PINK.darker());
        logoutBtn.setForeground(FONT_WHITE);

        buttonPanel.add(refreshBtn);
        buttonPanel.add(blockBtn);
        buttonPanel.add(deleteBtn);
        buttonPanel.add(logoutBtn);
        add(buttonPanel, BorderLayout.SOUTH);

        refreshBtn.addActionListener(e -> loadUsers(model));
        logoutBtn.addActionListener(e -> {
            dispose();
            new LoginScreen();
        });

        blockBtn.addActionListener(e -> toggleBlockUser(model));
        deleteBtn.addActionListener(e -> deleteUser(model));

        loadUsers(model);

        setVisible(true);
    }

    private void loadUsers(DefaultTableModel model) {
        model.setRowCount(0);
        List<User> users = Utils.loadUsers();
        for (User user : users) {
            Object[] row = {
                user.getNid(),
                user.getUsername(),
                user.getDob(),
                user.getAddress(),
                user.getSex(),
                user.getPhone(),
                user.getBalance(),
                user.isBlocked() ? "Yes" : "No"
            };
            model.addRow(row);
        }
    }

    private void toggleBlockUser(DefaultTableModel model) {
        int selectedRow = userTable.getSelectedRow();
        if (selectedRow == -1) {
            JOptionPane.showMessageDialog(this, "Please select a user to block/unblock.", "No Selection", JOptionPane.WARNING_MESSAGE);
            return;
        }
        String phone = (String) model.getValueAt(selectedRow, 5);
        List<User> users = Utils.loadUsers();
        for (User user : users) {
            if (user.getPhone().equals(phone)) {
                user.setBlocked(!user.isBlocked());
                Utils.saveUsers(users);
                loadUsers(model);
                JOptionPane.showMessageDialog(this, "User " + (user.isBlocked() ? "blocked." : "unblocked."));
                return;
            }
        }
    }

    private void deleteUser(DefaultTableModel model) {
        int selectedRow = userTable.getSelectedRow();
        if (selectedRow == -1) {
            JOptionPane.showMessageDialog(this, "Please select a user to delete.", "No Selection", JOptionPane.WARNING_MESSAGE);
            return;
        }
        String phone = (String) model.getValueAt(selectedRow, 5);
        List<User> users = Utils.loadUsers();
        User toRemove = null;
        for (User user : users) {
            if (user.getPhone().equals(phone)) {
                toRemove = user;
                break;
            }
        }
        if (toRemove != null) {
            int confirm = JOptionPane.showConfirmDialog(this, "Are you sure you want to delete user " + toRemove.getUsername() + "?", "Confirm Delete", JOptionPane.YES_NO_OPTION);
            if (confirm == JOptionPane.YES_OPTION) {
                users.remove(toRemove);
                Utils.saveUsers(users);
                loadUsers(model);
                JOptionPane.showMessageDialog(this, "User deleted.");
            }
        }
    }
}


