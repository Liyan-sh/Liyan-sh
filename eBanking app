import java.io.*;
import java.util.*;

public class Utils {
    public static final String USERS_FILE = "data/users.txt";
    public static final String TX_FILE = "data/transactions.txt";

    // Load all users from file
    public static List<User> loadUsers() {
        List<User> users = new ArrayList<>();
        try {
            File file = new File(USERS_FILE);
            if (!file.exists()) {
                file.getParentFile().mkdirs();
                file.createNewFile();
            }

            BufferedReader br = new BufferedReader(new FileReader(file));
            String line;
            while ((line = br.readLine()) != null) {
                users.add(User.fromFileString(line));
            }
            br.close();
        } catch (Exception e) {
            e.printStackTrace();
        }
        return users;
    }

    // Save all users to file
    public static void saveUsers(List<User> users) {
        try {
            PrintWriter pw = new PrintWriter(new FileWriter(USERS_FILE));
            for (User u : users) {
                pw.println(u.toFileString());
            }
            pw.close();
        } catch (IOException e) {
            e.printStackTrace();
        }
    }

    // Save a single user's update
    public static void saveUser(User user) {
        List<User> users = loadUsers();
        for (int i = 0; i < users.size(); i++) {
            if (users.get(i).getPhone().equals(user.getPhone())) {
                users.set(i, user);
                break;
            }
        }
        saveUsers(users);
    }

    // Append transaction to file
    public static void logTransaction(String message) {
        try {
            File file = new File(TX_FILE);
            if (!file.exists()) {
                file.getParentFile().mkdirs();
                file.createNewFile();
            }

            PrintWriter pw = new PrintWriter(new FileWriter(file, true));
            pw.println(new Date() + " - " + message);
            pw.close();
        } catch (IOException e) {
            e.printStackTrace();
        }
    }

    // Validation methods
    public static boolean isValidPhone(String phone) {
        return phone.matches("\\d{11}");
    }

    public static boolean isValidPin(String pin) {
        return pin.matches("\\d{5}");
    }

    public static boolean isValidNid(String nid) {
        return nid.matches("\\d{11}");
    }

    // Find user by phone number
    public static User findUserByPhone(String phone, List<User> users) {
        for (User u : users) {
            if (u.getPhone().equals(phone)) return u;
        }
        return null;
    }
}



