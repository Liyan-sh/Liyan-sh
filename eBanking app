        pinLabel.setForeground(FONT_WHITE);
        mainPanel.add(pinLabel, gbc);

        gbc.gridx = 1;
        pinField = new JPasswordField(15);
        pinField.setBackground(DARK_PINK.darker());
        pinField.setForeground(FONT_WHITE);
        mainPanel.add(pinField, gbc);

        gbc.gridx = 0;
        gbc.gridy = 2;
        gbc.gridwidth = 2;
        adminCheckBox = new JCheckBox("Login as Admin");
        adminCheckBox.setBackground(DARK_PINK);
        adminCheckBox.setForeground(FONT_WHITE);
        mainPanel.add(adminCheckBox, gbc);

        JPanel buttonPanel = new JPanel(new FlowLayout(FlowLayout.CENTER, 20, 10));
        buttonPanel.setBackground(DARK_PINK);
        loginBtn = new JButton("Login");
        loginBtn.setPreferredSize(new Dimension(120, 35));
        loginBtn.setBackground(DARK_PINK.darker());
        loginBtn.setForeground(FONT_WHITE);
        registerBtn = new JButton("Register");
        registerBtn.setPreferredSize(new Dimension(120, 35));
        registerBtn.setBackground(DARK_PINK.darker());
        registerBtn.setForeground(FONT_WHITE);
        buttonPanel.add(loginBtn);
        buttonPanel.add(registerBtn);

        add(buttonPanel, BorderLayout.SOUTH);

        loginBtn.addActionListener(e -> handleLogin());
        registerBtn.addActionListener(e -> {
            dispose();
            new RegisterScreen();
        });

        // Set font for all labels and buttons
        Font font = new Font("Segoe UI", Font.PLAIN, 14);
        for (Component comp : mainPanel.getComponents()) {
            comp.setFont(font);
            if (comp instanceof JLabel) {
                ((JLabel) comp).setForeground(FONT_WHITE);
            }
        }
        loginBtn.setFont(new Font("Segoe UI", Font.BOLD, 14));
        registerBtn.setFont(new Font("Segoe UI", Font.BOLD, 14));
        adminCheckBox.setFont(new Font("Segoe UI", Font.PLAIN, 14));

        pack();
        setMinimumSize(getSize());
        setVisible(true);
    }

    private void handleLogin() {
        String usernameOrPhone = phoneField.getText().trim();
        String pinOrPassword = new String(pinField.getPassword()).trim();

        if (adminCheckBox.isSelected()) {
            // Admin login
            if (isValidAdmin(usernameOrPhone, pinOrPassword)) {
                JOptionPane.showMessageDialog(this, "Admin login successful!", "Welcome Admin", JOptionPane.INFORMATION_MESSAGE);
                dispose();
                new AdminPanel();
            } else {
                showError("Invalid admin username or password.");
            }
        } else {
            // User login
            if (!Utils.isValidPhone(usernameOrPhone)) {
                showError("Phone number must be 11 digits.");
                return;
            }

            if (!Utils.isValidPin(pinOrPassword)) {
                showError("PIN must be 5 digits.");
                return;
            }

            List<User> users = Utils.loadUsers();
            User user = Utils.findUserByPhone(usernameOrPhone, users);

            if (user != null && user.getPin().equals(pinOrPassword)) {
                JOptionPane.showMessageDialog(this, "Login successful!", "Welcome", JOptionPane.INFORMATION_MESSAGE);
                dispose();
                new Dashboard(user);
            } else {
                showError("Invalid phone number or PIN.");
            }
        }
    }

    private boolean isValidAdmin(String username, String password) {
        Path adminFile = Paths.get("data/admin.txt");
        try {
            List<String> lines = Files.readAllLines(adminFile);
            for (String line : lines) {
